  "content": "[{\"id\":\"cn_titulo\",\"type\":\"header\",\"data\":{\"text\":\"<span class=\\\"h4\\\"><b>Conciliación Credinómina</b></span>\",\"col\":12}},{\"id\":\"cn_flujo_ayuda\",\"type\":\"paragraph\",\"data\":{\"text\":\"1. Cobranza vs. aplicación: control de calidad. 2. Aplicación vs. depósito: control financiero. El detalle de la empresa se carga únicamente en el depósito.\",\"col\":12}},{\"id\":\"cn_cartera\",\"type\":\"shortcut\",\"data\":{\"shortcut_name\":\"Cargar corte de cartera\",\"col\":3}},{\"id\":\"cn_periodo\",\"type\":\"shortcut\",\"data\":{\"shortcut_name\":\"Nuevo período\",\"col\":3}},{\"id\":\"cn_importar\",\"type\":\"shortcut\",\"data\":{\"shortcut_name\":\"Cargar aplicaciones\",\"col\":3}},{\"id\":\"cn_distribuir\",\"type\":\"shortcut\",\"data\":{\"shortcut_name\":\"Registrar depósito\",\"col\":3}},{\"id\":\"cn_procesos\",\"type\":\"header\",\"data\":{\"text\":\"<span class=\\\"h5\\\"><b>Flujo de trabajo</b></span>\",\"col\":12}},{\"id\":\"cn_etapa_1\",\"type\":\"card\",\"data\":{\"card_name\":\"1. Preparación\",\"col\":4}},{\"id\":\"cn_etapa_2\",\"type\":\"card\",\"data\":{\"card_name\":\"2. Cobranza y control\",\"col\":4}},{\"id\":\"cn_etapa_3\",\"type\":\"card\",\"data\":{\"card_name\":\"3. Aplicaciones del core\",\"col\":4}},{\"id\":\"cn_etapa_4\",\"type\":\"card\",\"data\":{\"card_name\":\"4. Depósitos y distribución\",\"col\":4}},{\"id\":\"cn_etapa_5\",\"type\":\"card\",\"data\":{\"card_name\":\"5. Diferencias y seguimiento\",\"col\":4}},{\"id\":\"cn_etapa_6\",\"type\":\"card\",\"data\":{\"card_name\":\"6. Control y reportes\",\"col\":4}},{\"id\":\"cn_flujo_historico\",\"type\":\"paragraph\",\"data\":{\"text\":\"En modalidad histórica, cree el período y cargue las aplicaciones; no se requiere cobranza ni deducción. El depósito y su detalle pueden recibirse después, incluso en otro mes.\",\"col\":12}},{\"id\":\"cn_administracion_cargas\",\"type\":\"header\",\"data\":{\"text\":\"<span class=\\\"h5\\\"><b>Administración de cargas</b></span>\",\"col\":12}},{\"id\":\"cn_lotes_cargas\",\"type\":\"card\",\"data\":{\"card_name\":\"Administración de cargas\",\"col\":12}}]",
